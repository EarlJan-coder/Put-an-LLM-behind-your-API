# Copy this file to .env and fill in your values. Never commit .env.
# Provider is chosen by these three variables alone - never hard-code one.
# Local Ollama example: LLM_BASE_URL=http://localhost:11434/v1/  LLM_API_KEY=ollama  LLM_MODEL=qwen3.5:4b
# Hosted example:        LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_API_KEY=<your key>  LLM_MODEL=<model name>
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_STUB=0
LLM_ENABLED=true
PORT=3000
